        "            html = \"<p style='color:red; font-weight:bold;'>Error: MSA is empty after processing. Cannot proceed.</p>\"\n",
        "        else:\n",
        "            print(\"Computing Sequence Logos...\")\n",
        "            logo_list = make_all_logos_per_position(seqs_list, logo_dir_name=LOGO_DIR_NAME)\n",
        "            print(\"\") \n",
        "\n",
        "            if not logo_list:\n",
        "                html = \"<p style='color:red; font-weight:bold;'>Error: Sequence Logo generation failed.</p>\"\n",
        "            elif analysis_options == \"All Above and Sequence Logos\":\n",
        "                html = color_msa_seqlogo(msa, LOGO_DIR_NAME)\n",
        "            else:\n",
        "                print(\"Computing Phylogenetic Tree...\")\n",
        "                if not output_msa_file or not os.path.exists(output_msa_file):\n",
        "                    print(f\"MSA file '{output_msa_file}' not found for tree generation. Attempting to write current MSA.\")\n",
        "                    try:\n",
        "                        SeqIO.write(msa, DEFAULT_MSA_FILE, 'fasta')\n",
        "                        output_msa_file = DEFAULT_MSA_FILE\n",
        "                    except Exception as e:\n",
        "                        print(f\"Error saving MSA for tree generation: {e}\")\n",
        "                        output_msa_file = None # Signal error\n",
        "                \n",
        "                if output_msa_file: # Only proceed if MSA file is valid\n",
        "                    output_tree_file_path = generate_phylo_tree(msa_input_file_path=output_msa_file, tree_output_file_name=DEFAULT_TREE_FILE)\n",
        "                else:\n",
        "                    output_tree_file_path = None\n",
        "\n",
        "                if not output_tree_file_path:\n",
        "                    html = \"<p style='color:red; font-weight:bold;'>Error: Phylogenetic Tree generation failed.</p>\"\n",
        "                else:\n",
        "                    branches, seq_ids_from_tree = hack_cladogram(tree_file_path=output_tree_file_path, ascii_tree_out_path=ASCII_TREE_FILE, equal_branch_tree_out_path=EQUAL_BRANCH_TREE_FILE)\n",
        "                    if branches is None or seq_ids_from_tree is None:\n",
        "                        html = \"<p style='color:red; font-weight:bold;'>Error: Cladogram generation failed.</p>\"\n",
