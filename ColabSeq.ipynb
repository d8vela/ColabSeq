    { # This is the "Core Functions" cell I will overwrite
      "cell_type": "code",
      "source": [
        "#@title Core Functions\n",
        "import subprocess\n",
        "import shutil\n",
        "\n",
        "# --- Constants ---\n",
        "DEFAULT_INPUT_SEQ_FILE = 'seq.fasta' \n",
        "DEFAULT_MSA_FILE = 'msa.fasta'     \n",
        "DEFAULT_TREE_FILE = 'msa.tree'      \n",
        "DEFAULT_RAXML_TREE_FILE_PATTERN = \"{base_file}.raxml.bestTree\" \n",
        "DEFAULT_CONSERVATION_SCORE_FILE = 'r4s.res' \n",
        "LOGO_DIR_NAME = 'logo'\n",
        "EQUAL_BRANCH_TREE_FILE = 'msa.equal.tree' \n",
        "ASCII_TREE_FILE = 'tree.txt' \n",
        "\n",
        "MUSCLE_TOOL_NAME = 'muscle'\n",
        "RAXML_NG_TOOL_NAME = 'raxml-ng'\n",
        "RAXML_NG_ZIP_NAME = 'raxml-ng_v1.2.0_linux_x86_64.zip' \n",
        "RAXML_NG_EXECUTABLE_IN_ZIP = 'raxml-ng' \n",
        "\n",
        "MUSCLE_LINUX_URL = 'https://github.com/rcedgar/muscle/releases/download/5.1.0/muscle5.1.linux_intel64'\n",
        "RAXML_NG_LINUX_URL = 'https://github.com/amkozlov/raxml-ng/releases/download/1.2.0/raxml-ng_v1.2.0_linux_x86_64.zip'\n",
        "\n",
        "AA_COLOR_CHEMICAL = {\n",
        "    'A': 'yellow', 'C': 'yellow', 'D': 'red',    'E': 'red',\n",
        "    'F': 'yellow', 'G': 'lime',   'H': 'cyan',   'I': 'yellow',\n",
        "    'K': 'cyan',   'L': 'yellow', 'M': 'yellow', 'N': 'orange',\n",
        "    'P': 'yellow', 'Q': 'orange', 'R': 'cyan',   'S': 'orange',\n",
        "    'T': 'orange', 'V': 'yellow', 'W': 'yellow', 'Y': 'yellow',\n",
        "    '-': 'white',  'X': 'grey'\n",
        "}\n",
        "\n",
        "# --- Helper Functions ---\n",
        "def _download_and_extract_tool(url: str, \n",
        "                               tool_name_on_disk: str, \n",
        "                               is_zip: bool = False, \n",
        "                               executable_name_in_zip: str = None, \n",
        "                               make_executable: bool = True) -> str | None:\n",
        "    \"\"\"\n",
        "    Downloads a tool, extracts if it's a zip, and makes it executable.\n",
        "    Returns the path to the tool if successful, None otherwise.\n",
        "    \"\"\"\n",
        "    tool_path = os.path.join(os.getcwd(), tool_name_on_disk)\n",
        "    \n",
        "    download_target_name = tool_name_on_disk + \".zip\" if is_zip else tool_name_on_disk\n",
        "    download_target_path = os.path.join(os.getcwd(), download_target_name)\n",
        "\n",
        "    if os.path.exists(tool_path):\n",
        "        return tool_path\n",
        "\n",
        "    if os.path.exists(download_target_path):\n",
        "        os.remove(download_target_path)\n",
        "    if is_zip and os.path.exists(tool_path) and os.path.isdir(tool_path): \n",
        "        shutil.rmtree(tool_path)\n",
        "    elif is_zip and os.path.exists(tool_path):\n",
        "        os.remove(tool_path)\n",
        "\n",
        "    print(f\"Downloading {tool_name_on_disk} from {url}...\")\n",
        "    try:\n",
        "        subprocess.run(['wget', '-q', url, '-O', download_target_path], check=True, timeout=300)\n",
        "        \n",
        "        actual_executable_path = tool_path\n",
        "        if is_zip:\n",
        "            print(f\"Extracting {download_target_name}...\")\n",
        "            extract_dir = os.getcwd()\n",
        "            if os.path.isdir(tool_path):\n",
        "                shutil.rmtree(tool_path)\n",
        "            elif os.path.isfile(tool_path):\n",
        "                os.remove(tool_path)\n",
        "\n",
        "            subprocess.run(['unzip', '-o', download_target_path, '-d', extract_dir], check=True, capture_output=True)\n",
        "            os.remove(download_target_path)\n",
        "            \n",
        "            if executable_name_in_zip:\n",
        "                path_in_zip = os.path.join(extract_dir, executable_name_in_zip)\n",
        "                zip_folder_name = RAXML_NG_ZIP_NAME.replace('.zip','')\n",
        "                path_in_zip_subdir = os.path.join(extract_dir, zip_folder_name, executable_name_in_zip)\n",
        "\n",
        "                if os.path.exists(path_in_zip_subdir):\n",
        "                    shutil.move(path_in_zip_subdir, tool_path)\n",
        "                elif os.path.exists(path_in_zip):\n",
        "                    if path_in_zip != tool_path:\n",
        "                        shutil.move(path_in_zip, tool_path)\n",
        "                actual_executable_path = tool_path\n",
        "\n",
        "        if make_executable and os.path.exists(actual_executable_path):\n",
        "            subprocess.run(['chmod', '+x', actual_executable_path], check=True)\n",
        "            \n",
        "        if os.path.exists(actual_executable_path):\n",
        "            return actual_executable_path\n",
        "        else:\n",
        "            print(f\"Failed to make {tool_name_on_disk} ready. Expected at: {actual_executable_path}\")\n",
        "            return None\n",
        "\n",
        "    except subprocess.CalledProcessError as e:\n",
        "        print(f\"Error during setup of {tool_name_on_disk}: {e}\")\n",
        "        if e.stdout: print(f\"Stdout: {e.stdout.decode(errors='ignore')}\")\n",
        "        if e.stderr: print(f\"Stderr: {e.stderr.decode(errors='ignore')}\")\n",
        "        if os.path.exists(download_target_path):\n",
        "            os.remove(download_target_path)\n",
        "        return None\n",
        "    except subprocess.TimeoutExpired:\n",
        "        print(f\"Timeout during download of {tool_name_on_disk}.\")\n",
        "        if os.path.exists(download_target_path):\n",
        "            os.remove(download_target_path)\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"An unexpected error occurred during setup of {tool_name_on_disk}: {str(e)}\")\n",
        "        if os.path.exists(download_target_path):\n",
        "            os.remove(download_target_path)\n",
        "        return None\n",
        "\n",
        "def _ensure_rate4site() -> bool:\n",
        "    \"\"\"Ensures rate4site is installed. Returns True if successful/already installed.\"\"\"\n",
        "    try:\n",
        "        subprocess.run(['rate4site', '--help'], capture_output=True, check=True, text=True, stderr=subprocess.DEVNULL, timeout=60)\n",
        "        return True\n",
        "    except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):\n",
        "        print(\"Attempting to install rate4site...\")\n",
        "        try:\n",
        "            subprocess.run(['apt-get', 'update', '-qq'], check=True, capture_output=True, timeout=120)\n",
        "            subprocess.run(['apt-get', 'install', '-y', '-qq', 'rate4site'], check=True, capture_output=True, timeout=120)\n",
        "            print(\"rate4site installed successfully.\")\n",
        "            return True\n",
        "        except subprocess.CalledProcessError as e:\n",
        "            print(f\"Error installing rate4site via apt-get: {e}\")\n",
        "            stderr_output = e.stderr.decode(errors='ignore') if e.stderr else \"No stderr.\"\n",
        "            if \"Unable to locate package\" in stderr_output:\n",
        "                 print(\"Rate4Site package not found. This might be due to outdated package lists or the package not being available.\")\n",
        "            else:\n",
        "                 if e.stdout: print(f\"Stdout: {e.stdout.decode(errors='ignore')}\")\n",
        "                 print(f\"Stderr: {stderr_output}\")\n",
        "            return False\n",
        "        except subprocess.TimeoutExpired:\n",
        "            print(\"Timeout during rate4site installation.\")\n",
        "            return False\n",
        "        except Exception as e_gen:\n",
        "            print(f\"An unexpected error occurred during rate4site installation: {e_gen}\")\n",
        "            return False\n",
        "\n",
        "# --- Core Functions ---\n",
        "def input_str_to_dict(input_str: str) -> dict:\n",
        "    \"\"\"\n",
        "    Converts an input string (FASTA or tab-delimited) to a dictionary of sequences.\n",
        "    Keys are sequence IDs, values are sequence strings.\n",
        "    FASTA IDs are taken as the first part before any '|'.\n",
        "    Sequences are converted to uppercase.\n",
        "    \"\"\"\n",
        "    input_dict = {}\n",
        "    lines = [line.strip() for line in input_str.replace('\\r\\n', '\\n').replace('\\r', '\\n').split('\\n') if line.strip()]\n",
        "\n",
        "    if not lines:\n",
        "        return input_dict\n",
        "\n",
        "    is_fasta = any(line.startswith('>') for line in lines)\n",
        "\n",
        "    if is_fasta:\n",
        "        current_id = None\n",
        "        current_seq_parts = []\n",
        "        for line in lines:\n",
        "            if line.startswith('>'):\n",
        "                if current_id is not None:\n",
        "                    input_dict[current_id] = ''.join(current_seq_parts)\n",
        "                current_id = line.split('|', 1)[0][1:].strip()\n",
        "                if not current_id:\n",
        "                    current_id = f\"unnamed_fasta_seq_{len(input_dict) + 1}\"\n",
        "                current_seq_parts = []\n",
        "            elif current_id is not None:\n",
        "                current_seq_parts.append(\"\".join(line.strip().upper().split()))\n",
        "        if current_id is not None:\n",
        "            input_dict[current_id] = ''.join(current_seq_parts)\n",
        "    else:\n",
        "        for line_num, line in enumerate(lines):\n",
        "            parts = line.split('\\t', 1)\n",
        "            if len(parts) != 2:\n",
        "                parts = re.split(r'\\s+', line, 1)\n",
        "\n",
        "            if len(parts) == 2:\n",
        "                seq_id, seq_val = parts[0].strip(), \"\".join(parts[1].strip().upper().split())\n",
        "                if not seq_id:\n",
        "                    seq_id = f\"seq_{line_num + 1}\"\n",
        "                input_dict[seq_id] = seq_val\n",
        "            elif len(parts) == 1 and parts[0]:\n",
        "                seq_candidate = \"\".join(parts[0].strip().upper().split())\n",
        "                if re.fullmatch(r'[A-Z*\\-]+', seq_candidate):\n",
        "                    input_dict[f\"seq_{line_num + 1}\"] = seq_candidate\n",
        "                else:\n",
        "                    print(f\"Skipping malformed line (expected ID and Sequence, or just Sequence): '{line}'\")\n",
        "            else:\n",
        "                print(f\"Skipping malformed line: '{line}'\")\n",
        "    return input_dict\n",
        "\n",
        "\n",
        "def check_aligned(input_dict: dict) -> bool:\n",
        "    if not input_dict: return True \n",
        "    sequence_values = list(input_dict.values())\n",
        "    if not sequence_values:\n",
        "        return True \n",
        "    first_len = len(sequence_values[0])\n",
        "    return all(len(seq) == first_len for seq in sequence_values)\n",
        "\n",
        "\n",
        "def generate_seqs (seqs_dict: dict) -> list:\n",
        "    seqs = []\n",
        "    for id_key, seq_val in seqs_dict.items():\n",
        "        seq_obj = SeqRecord(id=id_key, seq=Seq(seq_val), description='')\n",
        "        seqs.append(seq_obj)\n",
        "    return seqs\n",
        "\n",
        "\n",
        "def generate_msa (seqs: list, input_file_name: str = DEFAULT_INPUT_SEQ_FILE, output_file_name: str = DEFAULT_MSA_FILE) -> tuple[MultipleSeqAlignment | None, str | None]:\n",
        "    \"\"\"Generates a Multiple Sequence Alignment using MUSCLE.\"\"\"\n",
        "    muscle_exe = _download_and_extract_tool(MUSCLE_LINUX_URL, MUSCLE_TOOL_NAME)\n",
        "    if not muscle_exe:\n",
        "        print(\"MUSCLE executable not available. Cannot generate MSA.\")\n",
        "        return None, None\n",
        "\n",
        "    cwd = os.getcwd()\n",
        "    final_output_msa_path = os.path.join(cwd, output_file_name)\n",
        "\n",
        "    with tempfile.TemporaryDirectory() as temp_dir:\n",
        "        temp_input_file = os.path.join(temp_dir, input_file_name)\n",
        "        temp_output_file = os.path.join(temp_dir, output_file_name)\n",
        "\n",
        "        SeqIO.write(seqs, temp_input_file, 'fasta')\n",
        "\n",
        "        cline_args = [muscle_exe, '-super5', temp_input_file, '-output', temp_output_file]\n",
        "        print(f\"Running MUSCLE: {' '.join(cline_args)}\")\n",
        "        try:\n",
        "            subprocess.run(cline_args, capture_output=True, text=True, check=True, timeout=600)\n",
        "        except subprocess.CalledProcessError as e:\n",
        "            print(f\"MUSCLE execution failed: {e}\\nStdout: {e.stdout}\\nStderr: {e.stderr}\")\n",
        "            return None, None\n",
        "        except subprocess.TimeoutExpired:\n",
        "            print(\"MUSCLE execution timed out.\")\n",
        "            return None, None\n",
        "\n",
        "        if os.path.exists(temp_output_file) and os.path.getsize(temp_output_file) > 0:\n",
        "            shutil.copy(temp_output_file, final_output_msa_path)\n",
        "            try:\n",
        "                msa = AlignIO.read(final_output_msa_path, format='fasta')\n",
        "                if not msa or len(msa) == 0:\n",
        "                    print(\"MSA parsing resulted in an empty alignment. Check MUSCLE output.\")\n",
        "                    return None, final_output_msa_path\n",
        "                return msa, final_output_msa_path\n",
        "            except Exception as e_parse:\n",
        "                print(f\"Error parsing MSA output from {final_output_msa_path}: {e_parse}\")\n",
        "                return None, final_output_msa_path\n",
        "        else:\n",
        "            print(f\"MUSCLE did not produce a valid output file: {temp_output_file}\")\n",
        "            return None, None\n",
        "\n",
        "\n",
        "def color_msa_by_chemical_composition(msa: MultipleSeqAlignment) -> str:\n",
        "    html = \"<table>\"\n",
        "    for record in msa:\n",
        "        html += \"<tr>\"\n",
        "        html += f\"<td><b>{record.id}</b></td><td><b>:</b></td><td></td><td></td><td></td>\"\n",
        "        for aa in record.seq:\n",
        "            aa_upper = aa.upper()\n",
        "            color = AA_COLOR_CHEMICAL.get(aa_upper, 'grey')\n",
        "            html += f\"<td ALIGN=CENTER><font color='{color}'>{aa_upper}</font></td>\"\n",
        "        html += \"</tr>\"\n",
        "    html += \"</table>\"\n",
        "    return html\n",
        "\n",
        "\n",
        "def generate_phylo_tree(msa_input_file_path: str = DEFAULT_MSA_FILE, tree_output_file_name: str = DEFAULT_TREE_FILE) -> str | None:\n",
        "    \"\"\"Generates a phylogenetic tree using RAxML-NG.\"\"\"\n",
        "    raxml_ng_exe = _download_and_extract_tool(RAXML_NG_LINUX_URL, \n",
        "                                            RAXML_NG_TOOL_NAME, \n",
        "                                            is_zip=True, \n",
        "                                            executable_name_in_zip=RAXML_NG_EXECUTABLE_IN_ZIP)\n",
        "    if not raxml_ng_exe:\n",
        "        print(\"RAxML-NG executable not available. Cannot generate phylogenetic tree.\")\n",
        "        return None\n",
        "    \n",
        "    cwd = os.getcwd()\n",
        "    abs_msa_input_file = os.path.join(cwd, msa_input_file_path)\n",
        "    if not os.path.exists(abs_msa_input_file):\n",
        "        print(f\"MSA input file not found at {abs_msa_input_file} for RAxML-NG.\")\n",
        "        return None\n",
        "\n",
        "    final_output_tree_path = os.path.join(cwd, tree_output_file_name)\n",
        "    run_prefix = \"T_RAXML_RUN\"\n",
        "\n",
        "    with tempfile.TemporaryDirectory() as temp_dir:\n",
        "        temp_msa_file = os.path.join(temp_dir, os.path.basename(msa_input_file_path))\n",
        "        shutil.copy(abs_msa_input_file, temp_msa_file)\n",
        "        \n",
        "        cline_args = [raxml_ng_exe, '--search1', '--msa', temp_msa_file, \n",
        "                      '--model', 'LG+G8+F', '--threads', '2', '--seed', '12345', \n",
        "                      '--prefix', run_prefix, '--force'] \n",
        "        print(f\"Running RAxML-NG in {temp_dir}: {' '.join(cline_args)}\")\n",
        "        try:\n",
        "            subprocess.run(cline_args, cwd=temp_dir, capture_output=True, text=True, check=True, timeout=1800)\n",
        "        except subprocess.CalledProcessError as e:\n",
        "            print(f\"RAxML-NG execution failed: {e}\\nStdout: {e.stdout}\\nStderr: {e.stderr}\")\n",
        "            return None\n",
        "        except subprocess.TimeoutExpired:\n",
        "            print(\"RAxML-NG execution timed out.\")\n",
        "            return None\n",
        "\n",
        "        raxml_best_tree_in_temp = os.path.join(temp_dir, f'{run_prefix}.raxml.bestTree')\n",
        "\n",
        "        if os.path.exists(raxml_best_tree_in_temp) and os.path.getsize(raxml_best_tree_in_temp) > 0:\n",
        "            shutil.copy(raxml_best_tree_in_temp, final_output_tree_path)\n",
        "            return final_output_tree_path\n",
        "        else:\n",
        "            print(f\"RAxML-NG did not produce the expected best tree file: {raxml_best_tree_in_temp}\")\n",
        "            print(f\"Contents of {temp_dir}: {os.listdir(temp_dir)}\")\n",
        "            return None\n",
        "\n",
        "def src_from_data(data: bytes) -> str:\n",
        "    \"\"\"Base64 encodes image bytes for inclusion in an HTML img element\"\"\"\n",
        "    img_obj = Image(data=data)\n",
        "    for bundle in img_obj._repr_mimebundle_(): # type: ignore\n",
        "        for mimetype, b64value in bundle.items():\n",
        "            if mimetype.startswith('image/'):\n",
        "                return f'data:{mimetype};base64,{b64value}'\n",
        "    return '' \n",
        "\n",
        "\n",
        "def color_msa_seqlogo(msa: MultipleSeqAlignment, logo_dir: str = LOGO_DIR_NAME) -> str:\n",
        "    html = \"<table>\"\n",
        "    html += \"<tr><td></td><td></td>\"\n",
        "\n",
        "    axis_img_path = os.path.join(logo_dir, 'axis.png')\n",
        "    if os.path.exists(axis_img_path):\n",
        "        with open(axis_img_path, 'rb') as f:\n",
        "            logo_buffer = f.read()\n",
        "            src = src_from_data(logo_buffer)\n",
        "            logo_html = f'<image src=\"{src}\">'\n",
        "            html += f\"<td VALIGN=BOTTOM>{logo_html}</td>\"\n",
        "    else:\n",
        "        html += \"<td></td>\" \n",
        "\n",
        "    html += \"<td></td><td></td>\"\n",
        "\n",
        "    for idx in range(msa.get_alignment_length()):\n",
        "        pos_logo_path = os.path.join(logo_dir, f'{idx}.png')\n",
        "        if os.path.exists(pos_logo_path):\n",
        "            with open(pos_logo_path, 'rb') as f:\n",
        "                logo_buffer = f.read()\n",
        "                src = src_from_data(logo_buffer)\n",
        "                logo_html = f'<image src=\"{src}\">'\n",
        "                html += f\"<td>{logo_html}</td>\"\n",
        "        else:\n",
        "            html += \"<td></td>\" \n",
        "\n",
        "    html += \"</tr>\"\n",
        "\n",
        "    for record in msa:\n",
        "        html += \"<tr>\"\n",
        "        html += f\"<td><b>{record.id}</b></td><td><b>:</b></td><td></td><td></td><td></td>\"\n",
        "        for aa in record.seq:\n",
        "            aa_upper = aa.upper()\n",
        "            color = AA_COLOR_CHEMICAL.get(aa_upper, 'grey')\n",
        "            html += f\"<td><center><font color='{color}'>{aa_upper}</font></center></td>\"\n",
        "        html += \"</tr>\"\n",
        "    html += \"</table>\"\n",
        "    return html\n",
        "\n",
        "\n",
        "def chop_tree(file_object) -> tuple[list, list]:\n",
        "    lines = file_object.readlines()\n",
        "    seq_ids = []\n",
        "    max_line_len = 0\n",
        "    processed_lines_for_len = []\n",
        "\n",
        "    for line in lines:\n",
        "        stripped_line = line.rstrip('\\n')\n",
        "        seq_id_match = re.search(r'_ (\\S+)$', stripped_line)\n",
        "        current_line_content = stripped_line\n",
        "        if seq_id_match:\n",
        "            seq_ids.append(seq_id_match.group(1))\n",
        "            current_line_content = re.sub(r'_ \\S+$', '_', stripped_line)\n",
        "        \n",
        "        processed_lines_for_len.append(current_line_content)\n",
        "        if len(current_line_content) > max_line_len:\n",
        "            max_line_len = len(current_line_content)\n",
        "\n",
        "    branches = []\n",
        "    for line_content in processed_lines_for_len:\n",
        "        if line_content.endswith('_'):\n",
        "            padding = '_' * (max_line_len - len(line_content))\n",
        "            branches.append(line_content + padding)\n",
        "        else:\n",
        "            branches.append(line_content.ljust(max_line_len))\n",
        "            \n",
        "    return branches, seq_ids\n",
        "\n",
        "def html_rebuilt_tree(branches: list, seq_ids: list) -> str:\n",
        "    idx = 0\n",
        "    html = '<tt><table>'\n",
        "    for stick in branches:\n",
        "        html += \"<tr>\"\n",
        "        display_stick = stick.replace(' ', '&nbsp;')\n",
        "        if stick.strip().endswith('_') and idx < len(seq_ids):\n",
        "            html += f'<td>{display_stick}</td><td>{seq_ids[idx]}</td>'\n",
        "            idx += 1\n",
        "        else:\n",
        "            html += f'<td>{display_stick}</td><td></td>'\n",
        "        html += \"</tr>\"\n",
        "    html += \"</table></tt>\"\n",
        "    return html\n",
        "\n",
        "\n",
        "def color_msa_seqlogo_phylotree(msa: MultipleSeqAlignment, branches: list, seq_ids_from_tree: list, logo_dir: str = LOGO_DIR_NAME) -> str:\n",
        "    html = \"<table border=0 cellspacing=0 cellpadding=0 style='border-collapse:collapse; font-family: monospace;'>\"\n",
        "    html += \"<tr><td></td><td></td><td></td>\"\n",
        "\n",
        "    axis_img_path = os.path.join(logo_dir, 'axis.png')\n",
        "    if os.path.exists(axis_img_path):\n",
        "        with open(axis_img_path, 'rb') as f:\n",
        "            src = src_from_data(f.read())\n",
        "            html += f\"<td COLSPAN=2 VALIGN=BOTTOM ALIGN=RIGHT style='padding:0px 2px;'><image src='{src}'></td>\"\n",
        "    else:\n",
        "        html += \"<td COLSPAN=2></td>\"\n",
        "\n",
        "    for idx in range(msa.get_alignment_length()):\n",
        "        pos_logo_path = os.path.join(logo_dir, f'{idx}.png')\n",
        "        if os.path.exists(pos_logo_path):\n",
        "            with open(pos_logo_path, 'rb') as f:\n",
        "                src = src_from_data(f.read())\n",
        "                html += f\"<td VALIGN=BOTTOM style='padding:0px;'><image src='{src}'></td>\"\n",
        "        else:\n",
        "            html += \"<td style='padding:0px;'></td>\"\n",
        "    html += \"</tr>\"\n",
        "\n",
        "    msa_dict = {record.id: str(record.seq) for record in msa}\n",
        "    tree_idx = 0\n",
        "    for stick in branches:\n",
        "        html += \"<tr>\"\n",
        "        display_stick = stick.replace(' ', '&nbsp;')\n",
        "        is_leaf_row = stick.strip().endswith('_') and tree_idx < len(seq_ids_from_tree)\n",
        "\n",
        "        if is_leaf_row:\n",
        "            current_seq_id = seq_ids_from_tree[tree_idx]\n",
        "            html += f'<td style=\"padding:0px 2px;\"><tt>{display_stick}</tt></td>'\n",
        "            html += \"<td style='padding:0px 2px;'></td><td style='padding:0px 2px;'></td>\"\n",
        "            \n",
        "            seq_to_display = msa_dict.get(current_seq_id, \"ERROR: Seq ID from tree not in MSA\")\n",
        "            html += f\"<td COLSPAN=2 style='padding:0px 2px;'><tt><b>{current_seq_id[:10]}&nbsp;:&nbsp;</b></tt></td>\"\n",
        "\n",
        "            if \"ERROR\" in seq_to_display:\n",
        "                 html += f\"<td colspan='{msa.get_alignment_length()}'><font color='red'>{seq_to_display}</font></td>\"\n",
        "            else:\n",
        "                for aa_char in seq_to_display:\n",
        "                    color = AA_COLOR_CHEMICAL.get(aa_char.upper(), 'grey')\n",
        "                    html += f\"<td style='padding:0px 1px;' ALIGN=CENTER><font color='{color}' size='-1'>{aa_char}</font></td>\"\n",
        "            tree_idx += 1\n",
        "        else:\n",
        "            html += f'<td style=\"padding:0px 2px;\"><tt>{display_stick}</tt></td>'\n",
        "            html += f\"<td colspan='{msa.get_alignment_length() + 4}'></td>\"\n",
        "        html += \"</tr>\"\n",
        "    html += \"</table>\"\n",
        "    return html\n",
        "\n",
        "\n",
        "def make_all_logos_per_position(seqs_list: list, logo_dir_name: str = LOGO_DIR_NAME) -> list:\n",
        "    if not seqs_list:\n",
        "        print(\"Sequence list is empty, cannot generate logos.\")\n",
        "        return []\n",
        "        \n",
        "    matplotlib.use('Agg')\n",
        "    warnings.filterwarnings(\"ignore\")\n",
        "    os.makedirs(logo_dir_name, exist_ok=True)\n",
        "\n",
        "    try:\n",
        "        msa_df = logomaker.alignment_to_matrix(sequences=seqs_list, to_type='counts')\n",
        "        msa_df = logomaker.transform_matrix(msa_df, from_type='counts', to_type='probability', pseudocount=0.00001)\n",
        "        msa_df = logomaker.transform_matrix(msa_df, from_type='probability', to_type='information')\n",
        "    except Exception as e:\n",
        "        print(f\"Error processing sequences with logomaker: {e}\")\n",
        "        return [] \n",
        "\n",
        "    alphabet = set(\"\".join(s.upper() for s in seqs_list if isinstance(s, str)))\n",
        "    relevant_chars = alphabet - {'-', '*'}\n",
        "    alphabet_size = len(relevant_chars) if relevant_chars else 20 # Default to 20 if empty or only gaps\n",
        "    max_entropy = math.log(alphabet_size, 2) if alphabet_size > 1 else 1.0\n",
        "    \n",
        "    ax_color = 'black'\n",
        "\n",
        "    ax_df = msa_df.iloc[[0]].copy(deep=True)\n",
        "    for col in ax_df.columns:\n",
        "        ax_df[col].values[:] = 0\n",
        "\n",
        "    ax_logo = logomaker.Logo(ax_df,\n",
        "                            color_scheme='gray',\n",
        "                            font_name='Arial Rounded MT Bold',\n",
        "                            figsize=(.2,1.75))\n",
        "    ax_logo.ax.set_axis_on()\n",
        "    # Ensure yticks are reasonable for the calculated max_entropy\n",
        "    ax_logo.ax.set_yticks(np.arange(0, math.ceil(max_entropy) + 1, 1))\n",
        "    ax_logo.ax.set_ylabel('bits', fontdict=dict(fontweight='bold'), color=ax_color)\n",
        "    ax_logo.ax.get_xaxis().set_visible(False)\n",
        "    ax_logo.ax.set_ylim([0, max_entropy if max_entropy > 0 else 1])\n",
        "    ax_logo.ax.tick_params(axis='y', colors=ax_color)\n",
        "    for spine_pos in ['left', 'top', 'right', 'bottom']:\n",
        "        ax_logo.ax.spines[spine_pos].set_color(ax_color)\n",
        "    plt.savefig(os.path.join(logo_dir_name, 'axis.png'), transparent=True, bbox_inches=\"tight\", dpi=100)\n",
        "    plt.close()\n",
        "\n",
        "    plt.ioff()\n",
        "    generated_logos = ['axis.png']\n",
        "    for idx in tqdm(range(len(msa_df))):\n",
        "        pos_df = msa_df.iloc[[idx]]\n",
        "        ww_logo = logomaker.Logo(pos_df,\n",
        "                                color_scheme=AA_COLOR_CHEMICAL,\n",
        "                                font_name='Arial Rounded MT Bold',\n",
        "                                vpad=0.05, vsep=0.05,\n",
        "                                show_spines=False,\n",
        "                                figsize=(.2,1.5))\n",
        "        ww_logo.ax.set_ylim([0, max_entropy if max_entropy > 0 else 1])\n",
        "        ww_logo.ax.set_axis_off()\n",
        "        logo_filename = f'{idx}.png'\n",
        "        plt.savefig(os.path.join(logo_dir_name, logo_filename), transparent=True, bbox_inches=\"tight\", dpi=100)\n",
        "        plt.close()\n",
        "        generated_logos.append(logo_filename)\n",
        "\n",
        "    warnings.resetwarnings()\n",
        "    matplotlib.use('module://matplotlib_inline.backend_inline')\n",
        "    return generated_logos\n",
        "\n",
        "\n",
        "def hack_cladogram(tree_file_path: str = DEFAULT_TREE_FILE, \n",
        "                   ascii_tree_out_path: str = ASCII_TREE_FILE, \n",
        "                   equal_branch_tree_out_path: str = EQUAL_BRANCH_TREE_FILE) -> tuple[list | None, list | None]:\n",
        "    if not os.path.exists(tree_file_path):\n",
        "        print(f\"Tree file {tree_file_path} not found for cladogram generation.\")\n",
        "        return None, None\n",
        "    \n",
        "    try:\n",
        "        tree = Phylo.read(tree_file_path, \"newick\")\n",
        "        for clade in tree.find_clades():\n",
        "            clade.branch_length = 1.0\n",
        "        Phylo.write(tree, equal_branch_tree_out_path, \"newick\")\n",
        "    except Exception as e_phylo:\n",
        "        print(f\"Bio.Phylo modification failed ({e_phylo}). Attempting perl fallback.\")\n",
        "        try:\n",
        "            with open(equal_branch_tree_out_path, 'w') as f_out:\n",
        "                subprocess.run(['perl', '-pe', 's/([):,])\\s*\\d*\\.?\\d*([eE][-+]?\\d+)?/\\11.0/g', tree_file_path], stdout=f_out, check=True)\n",
        "        except (subprocess.CalledProcessError, FileNotFoundError) as e_perl:\n",
        "            print(f\"Perl command for equal branch lengths also failed: {e_perl}. Using original tree.\")\n",
        "            shutil.copy(tree_file_path, equal_branch_tree_out_path)\n",
        "\n",
        "    try:\n",
        "        tree_for_ascii = Phylo.read(equal_branch_tree_out_path, \"newick\")\n",
        "        with open(ascii_tree_out_path, 'w') as f:\n",
        "            Phylo.draw_ascii(tree_for_ascii, file=f, column_width=60)\n",
        "    except Exception as e_draw:\n",
        "        print(f\"Error drawing ASCII tree: {e_draw}\")\n",
        "        return None, None\n",
        "\n",
        "    if os.path.exists(ascii_tree_out_path):\n",
        "        with open(ascii_tree_out_path, 'r') as f:\n",
        "            branches, seq_ids = chop_tree(f)\n",
        "        return branches, seq_ids\n",
        "    else:\n",
        "        print(f\"ASCII tree file {ascii_tree_out_path} not created.\")\n",
        "        return None, None\n",
        "\n",
        "\n",
        "def rate4site(msa_file_path: str = DEFAULT_MSA_FILE, \n",
        "              tree_file_path: str = DEFAULT_TREE_FILE, \n",
        "              output_score_file_name: str = DEFAULT_CONSERVATION_SCORE_FILE) -> tuple[list | None, list | None, list | None, str | None]:\n",
        "    if not _ensure_rate4site():\n",
        "        print(\"Rate4Site is not installed/available. Cannot calculate conservation scores.\")\n",
        "        return None, None, None, None\n",
        "    \n",
        "    cwd = os.getcwd()\n",
        "    abs_msa_file = os.path.join(cwd, msa_file_path)\n",
        "    abs_tree_file = os.path.join(cwd, tree_file_path)\n",
        "    final_output_score_path = os.path.join(cwd, output_score_file_name)\n",
        "\n",
        "    if not os.path.exists(abs_msa_file):\n",
        "        print(f\"MSA file not found: {abs_msa_file}\")\n",
        "        return None, None, None, None\n",
        "    if not os.path.exists(abs_tree_file):\n",
        "        print(f\"Tree file not found: {abs_tree_file}\")\n",
        "        return None, None, None, None\n",
        "\n",
        "    with tempfile.TemporaryDirectory() as temp_dir:\n",
        "        temp_msa = os.path.join(temp_dir, os.path.basename(msa_file_path))\n",
        "        temp_tree = os.path.join(temp_dir, os.path.basename(tree_file_path))\n",
        "        shutil.copy(abs_msa_file, temp_msa)\n",
        "        shutil.copy(abs_tree_file, temp_tree)\n",
        "        \n",
        "        temp_r4s_res = os.path.join(temp_dir, \"r4s_temp_output.res\")\n",
        "\n",
        "        cline_args = ['rate4site', '-M', 'LG', '-t', temp_tree, '-s', temp_msa, '-o', temp_r4s_res]\n",
        "        print(f\"Running Rate4Site: {' '.join(cline_args)}\")\n",
        "        try:\n",
        "            subprocess.run(cline_args, capture_output=True, text=True, check=True, timeout=600)\n",
        "        except subprocess.CalledProcessError as e:\n",
        "            print(f\"Rate4Site execution failed: {e}\\nStdout: {e.stdout}\\nStderr: {e.stderr}\")\n",
        "            return None, None, None, None\n",
        "        except subprocess.TimeoutExpired:\n",
        "            print(\"Rate4Site execution timed out.\")\n",
        "            return None, None, None, None\n",
        "\n",
        "        if os.path.exists(temp_r4s_res) and os.path.getsize(temp_r4s_res) > 0:\n",
        "            shutil.copy(temp_r4s_res, final_output_score_path)\n",
        "        else:\n",
        "            print(f\"Rate4Site output file {temp_r4s_res} not found or empty.\")\n",
        "            return None, None, None, None\n",
        "\n",
        "    conserve_scores = []\n",
        "    if os.path.exists(final_output_score_path):\n",
        "        with open(final_output_score_path) as f:\n",
        "            for line in f:\n",
        "                line = line.strip()\n",
        "                if line and not line.startswith('#'):\n",
        "                    try:\n",
        "                        parts = line.split()\n",
        "                        score = float(parts[2])\n",
        "                        conserve_scores.append(score)\n",
        "                    except (IndexError, ValueError) as e:\n",
        "                        print(f\"Skipping malformed line in Rate4Site output: '{line}' ({e})\")\n",
        "    else:\n",
        "        return None, None, None, None \n",
        "\n",
        "    if not conserve_scores:\n",
        "        print(\"No conservation scores parsed.\")\n",
        "        return [], [], [], final_output_score_path\n",
        "\n",
        "    min_s, max_s = min(conserve_scores), max(conserve_scores)\n",
        "    s_range = max_s - min_s\n",
        "    conserve_scores_rescale = [(s - min_s) / s_range if s_range > 1e-9 else 0.5 for s in conserve_scores]\n",
        "\n",
        "    conserve_classes = np.digitize(conserve_scores_rescale, bins=np.linspace(0, 1, 10), right=True)\n",
        "    conserve_classes = [max(1, 10 - c) for c in conserve_classes] # Invert so 9 is most conserved\n",
        "    # Ensure classes are within 1-9 range\n",
        "    conserve_classes = [min(9, max(1, c)) for c in conserve_classes]\n",
        "\n",
        "    return conserve_scores, conserve_classes, conserve_scores_rescale, final_output_score_path\n",
        "\n",
        "\n",
        "def msa2seq_pos(align_seq: str) -> dict:\n",
        "    \"\"\"Converts MSA position (1-based) to sequence position (1-based, ungapped).\"\"\"\n",
        "    msa2seq_pos_dict = {}\n",
        "    seq_pos = 0\n",
        "    for msa_idx, aa in enumerate(align_seq):\n",
        "        msa_current_pos = msa_idx + 1\n",
        "        if aa != '-':\n",
        "            seq_pos += 1\n",
        "            msa2seq_pos_dict[msa_current_pos] = seq_pos\n",
        "        else:\n",
        "            msa2seq_pos_dict[msa_current_pos] = '-'\n",
        "    return msa2seq_pos_dict\n",
        "\n",
        "\n",
        "def color_msa_seqlogo_phylotree_conserve(msa: MultipleSeqAlignment, branches: list, seq_ids_from_tree: list, \n",
        "                                       conserve_classes: list, logo_dir: str =LOGO_DIR_NAME) -> str:\n",
        "    html = \"<table border=0 cellspacing=0 cellpadding=0 style='border-collapse:collapse; font-family: monospace;'>\"\n",
        "    html += \"<tr><td></td><td></td><td></td>\" \n",
        "\n",
        "    axis_img_path = os.path.join(logo_dir, 'axis.png')\n",
        "    if os.path.exists(axis_img_path):\n",
        "        with open(axis_img_path, 'rb') as f:\n",
        "            src = src_from_data(f.read())\n",
        "            html += f\"<td COLSPAN=2 VALIGN=BOTTOM ALIGN=RIGHT style='padding:0px 2px;'><image src='{src}'></td>\"\n",
        "    else:\n",
        "        html += \"<td COLSPAN=2></td>\"\n",
        "\n",
        "    for idx in range(msa.get_alignment_length()):\n",
        "        pos_logo_path = os.path.join(logo_dir, f'{idx}.png')\n",
        "        if os.path.exists(pos_logo_path):\n",
        "            with open(pos_logo_path, 'rb') as f:\n",
        "                src = src_from_data(f.read())\n",
        "                html += f\"<td VALIGN=BOTTOM style='padding:0px;'><image src='{src}'></td>\"\n",
        "        else:\n",
        "            html += \"<td style='padding:0px;'></td>\"\n",
        "    html += \"</tr>\"\n",
        "\n",
        "    msa_dict = {record.id: str(record.seq) for record in msa}\n",
        "    first_id = msa[0].id if msa and len(msa) > 0 else None\n",
        "    first_seq = msa_dict.get(first_id, \"\")\n",
        "    m2s_pos = msa2seq_pos(first_seq)\n",
        "\n",
        "    purple_gradient = ['#2d0367','#3d0589','#4c06ac','#5b07ce','#6b08f0',\n",
        "                       '#7e26f6','#9349f8','#a76bf9','#bb8dfa'] # class 1 (least) to 9 (most)\n",
        "    # Gradient index should be 9-class_val for this order\n",
        "\n",
        "    tree_idx = 0\n",
        "    for stick in branches:\n",
        "        html += \"<tr>\"\n",
        "        display_stick = stick.replace(' ', '&nbsp;')\n",
        "        is_leaf_row = stick.strip().endswith('_') and tree_idx < len(seq_ids_from_tree)\n",
        "\n",
        "        if is_leaf_row:\n",
        "            current_seq_id = seq_ids_from_tree[tree_idx]\n",
        "            html += f'<td style=\"padding:0px 2px;\"><tt>{display_stick}</tt></td>'\n",
        "            html += \"<td style='padding:0px 2px;'></td><td style='padding:0px 2px;'></td>\"\n",
        "            \n",
        "            seq_to_display = msa_dict.get(current_seq_id, \"ERROR: Seq ID from tree not in MSA\")\n",
        "            html += f\"<td COLSPAN=2 style='padding:0px 2px;'><tt><b>{current_seq_id[:10]}&nbsp;:&nbsp;</b></tt></td>\"\n",
        "\n",
        "            if \"ERROR\" in seq_to_display:\n",
        "                 html += f\"<td colspan='{msa.get_alignment_length()}'><font color='red'>{seq_to_display}</font></td>\"\n",
        "            else:\n",
        "                for aa_char in seq_to_display:\n",
        "                    color = AA_COLOR_CHEMICAL.get(aa_char.upper(), 'grey')\n",
        "                    html += f\"<td style='padding:0px 1px;' ALIGN=CENTER><font color='{color}' size='-1'>{aa_char}</font></td>\"\n",
        "            tree_idx += 1\n",
        "        else: \n",
        "            html += f'<td style=\"padding:0px 2px;\"><tt>{display_stick}</tt></td>'\n",
        "            html += \"<td style='padding:0px 2px;'></td><td style='padding:0px 2px;'></td>\" \n",
        "            html += \"<td COLSPAN=2 style='padding:0px 2px;'></td>\" \n",
        "            for i in range(msa.get_alignment_length()):\n",
        "                msa_col_idx = i + 1\n",
        "                if m2s_pos.get(msa_col_idx) != '-':\n",
        "                    seq_pos_idx = m2s_pos.get(msa_col_idx)\n",
        "                    if seq_pos_idx is not None and (seq_pos_idx -1) < len(conserve_classes):\n",
        "                        class_val = conserve_classes[seq_pos_idx-1]\n",
        "                        gradient_idx = 9 - class_val \n",
        "                        if 0 <= gradient_idx < len(purple_gradient):\n",
        "                           html += f\"<td ALIGN=CENTER style='padding:0px 1px; background-color:#{purple_gradient[gradient_idx]}'></td>\"\n",
        "                        else:\n",
        "                           html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\" \n",
        "                    else:\n",
        "                        html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\"\n",
        "                else:\n",
        "                    html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\"\n",
        "        html += \"</tr>\"\n",
        "    \n",
        "    html += \"<tr>\"\n",
        "    html += \"<td ALIGN=RIGHT COLSPAN=5 style='padding:0px 2px;'><b><tt>Conservation&nbsp;:&nbsp;</tt></b></td>\"\n",
        "    for i in range(msa.get_alignment_length()):\n",
        "        msa_col_idx = i + 1\n",
        "        if m2s_pos.get(msa_col_idx) != '-':\n",
        "            seq_pos_idx = m2s_pos.get(msa_col_idx)\n",
        "            if seq_pos_idx is not None and (seq_pos_idx -1) < len(conserve_classes):\n",
        "                class_val = conserve_classes[seq_pos_idx-1]\n",
        "                gradient_idx = 9 - class_val\n",
        "                if 0 <= gradient_idx < len(purple_gradient):\n",
        "                    text_color = 'white' if class_val >= 7 else 'black' # Class 7,8,9 are darker shades\n",
        "                    html += f\"<td ALIGN=CENTER style='padding:0px 1px; background-color:#{purple_gradient[gradient_idx]}'><tt><font color='{text_color}' size='-2'>{class_val}</font></tt></td>\"\n",
        "                else:\n",
        "                    html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\"\n",
        "            else:\n",
        "                html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\"\n",
        "        else:\n",
        "            html += f\"<td style='padding:0px 1px;'>&nbsp;</td>\"\n",
        "    html += \"</tr>\"\n",
        "    html += \"</table>\"\n",
        "    return html"
      ],
