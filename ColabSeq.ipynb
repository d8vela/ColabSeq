        "\n",
        "# Initialize variables that will be used in download cells\n",
        "output_msa_file = DEFAULT_MSA_FILE # Default, might be overwritten\n",
        "output_tree_file_path = DEFAULT_TREE_FILE # Default, might be overwritten\n",
        "output_conservation_score_file_path = DEFAULT_CONSERVATION_SCORE_FILE # Default\n",
        "html = \"\" # Initialize html output string\n",
        "\n",
        "# Generate dictionary of sequence input string\n",
        "seqs_dict = input_str_to_dict(input_str)\n",
        "\n",
        "# Generate list of sequence records from dictionary\n",
        "seqs = generate_seqs(seqs_dict)\n",
        "\n",
        "msa = None \n",
        "\n",
        "if not seqs:\n",
        "    print(\"No sequences provided or parsed. Please check input.\")\n",
        "    html = \"<p style='color:red; font-weight:bold;'>Error: No sequences provided or parsed. Cannot proceed.</p>\"\n",
        "elif check_aligned(seqs_dict):\n",
        "    print(\"Detected pre-aligned MSA...\")\n",
        "    records = []\n",
        "    for id_key in seqs_dict:\n",
        "        record = SeqRecord(Seq(seqs_dict[id_key]), id=id_key)\n",
        "        records.append(record)\n",
        "    if records:\n",
        "        msa = MultipleSeqAlignment(records)\n",
        "        # Save the pre-aligned MSA to the default output file name for consistency\n",
        "        try:\n",
        "            SeqIO.write(msa, DEFAULT_MSA_FILE, 'fasta') \n",
        "            output_msa_file = DEFAULT_MSA_FILE \n",
        "            print(f\"Pre-aligned MSA saved to {output_msa_file}\")\n",
        "        except Exception as e:\n",
        "            print(f\"Error saving pre-aligned MSA: {e}\")\n",
        "            html = f\"<p style='color:red; font-weight:bold;'>Error saving pre-aligned MSA: {e}</p>\"\n",
        "            msa = None # Do not proceed if saving failed\n",
        "    else:\n",
        "        print(\"Sequence dictionary was not empty, but no SeqRecords created. Check input format.\")\n",
        "        html = \"<p style='color:red; font-weight:bold;'>Error: Could not process pre-aligned sequences.</p>\"\n",
        "else:\n",
        "    print(\"Computing MSA...\")\n",
