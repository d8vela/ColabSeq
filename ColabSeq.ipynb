        "    if output_msa_file_path_from_func:\n",
        "        output_msa_file = output_msa_file_path_from_func # Update for download cell\n",
        "    if not msa:\n",
        "        html = \"<p style='color:red; font-weight:bold;'>Error: MSA generation failed. Cannot proceed.</p>\"\n",
        "\n",
        "if msa and len(msa) > 0:\n",
